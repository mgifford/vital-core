node_modules/
.e2e-sandbox/
.history-cache/
ci_job_*.zip
job-*-logs.zip
tmp/

# Generated site. Built by aggregate in CI and deployed as a Pages
# artifact; never committed. Summaries that must survive live in data/.
docs/

# Old build output (no longer produced; kept ignored to prevent reintroduction).
dist/

*.log
.DS_Store

# Local secrets (HF_TOKEN, etc.). Provided to CI via repository secrets,
# never committed. Commit .env.example with key names only if you want a
# template.
.env
.env.*
!.env.example

# Crawl state is mutable and large (up to ~57 MB per domain). CI keeps it
# as assets on the `scan-state` release (scripts/state-release.js); locally
# it is a plain on-disk directory. Committing it grew .git by ~1.4 GB in
# three months.
/state/

# Scan data lives in its own repo (`data_repo` in config/targets.yml). CI
# checks it out into data/; locally, clone it there only when you need it.
# Anchored to the root: an unanchored data/ also matched src/data/, so a new
# file there was silently left out of `git add`.
/data/

# HF-only targets — scanned on Hugging Face, not GitHub Actions.
# Guard against accidental commit of their scan data to this repo.
# Unanchored on purpose, so they still match if VITAL_DATA_ROOT points at a
# directory inside the checkout.
**/data/www.va.gov/
**/data/volunteer.va.gov/
**/data/news.va.gov/
**/data/benefits.va.gov/
**/state/www.va.gov/
**/state/volunteer.va.gov/
**/state/news.va.gov/
**/state/benefits.va.gov/

# Spec Kitty runtime state (transient, machine-specific)
.kittify/runtime/
.kittify/charter/context-state.json
.kittify/encoding-provenance/
.kittify/events/
.kittify/lint-report.json
.kittify/workspaces/
.kittify/sync-state.json
.worktrees/

# Legacy Spec Kitty managed symlink packs. Current repo-local Codex command
# skills are real files named .agents/skills/spec-kitty.*.
.agents/skills/ad-hoc-profile-load/
.agents/skills/spec-kitty/
.agents/skills/spec-kitty-*/
.agents/skills/spk-*/

# Claude Code: launch.json is shared; personal permission allowlist is not.
.claude/settings.local.json
