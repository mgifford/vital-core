adata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":9,"total":11,"social":[],"og":{"title":"CMS Announces Approval of Oklahoma & Maine’s Substance Use Disorder Demonstrations, the 30th and 31st to Expand Access to Combat the Opioid Crisis","description":"The Centers for Medicare & Medicaid Services (CMS) announced today, the approval of both the Oklahoma and Maine section 1115 demonstrations to expand treatment for substance abuse disorder. CMS approved Oklahoma’s new demonstration, titled “Institutions for Mental Diseases Waiver for Serious Mental Illness/Substance Use Disorder,” and Maine’s new demonstration, entitled “Maine Substance Use Disorder (SUD) Care Initiative.” These Medicaid Substance Use Disorder (SUD) demonstration projects are the 30th and 31st","url":"https://www.cms.gov/newsroom/press-releases/cms-announces-approval-oklahoma-maines-substance-use-disorder-demonstrations-30th-31st-expand-access","image":null,"siteName":"CMS","type":null},"resilience":{"checks":[{"id":"pwa-https","label":"HTTPS (required for service workers)","status":"pass","evidence":"","exampleUrl":"https://www.cms.gov/newsroom/press-releases/cms-announces-approval-oklahoma-maines-substance-use-disorder-demonstrations-30th-31st-expand-access","why":"HTTPS is required for service workers and most install prompts."},{"id":"pwa-manifest","label":"Web app manifest declared","status":"fail","evidence":"","exampleUrl":"https://www.cms.gov/newsroom/press-releases/cms-announces-approval-oklahoma-maines-substance-use-disorder-demonstrations-30th-31st-expand-access","why":"A web app manifest is required for installability and controls how the app appears when launched."},{"id":"pwa-service-worker","label":"Service worker registered","status":"fail","evidence":"","exampleUrl":"https://www.cms.gov/newsroom/press-releases/cms-announces-approval-oklahoma-maines-substance-use-disorder-demonstrations-30th-