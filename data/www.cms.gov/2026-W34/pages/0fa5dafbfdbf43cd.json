{"pageId":"0fa5dafbfdbf43cd","url":"https://cms.gov/newsroom/press-releases/hhs-would-increase-rewards-reporting-fraud-nearly-10-million","week":"2026-W34","runId":"2026-08-18T06-33-21-161Z-56b51d","scannedAt":"2026-08-18T06:46:41.698Z","status":200,"depth":7,"axe":{"engine":"axe-core","version":"4.12.1","violationCount":0,"violations":{},"incompleteCount":19},"alfa":{"engine":"alfa","version":"0.117.0","failedCount":64,"failed":{"sia-r73":{"count":19,"ruleUrl":"https://alfa.siteimprove.com/rules/sia-r73","examples":[{"target":"<p class=\"ds-c-usa-banner__header-text\">"},{"target":"<p class=\"ds-c-usa-banner__action ds-u-align-items--center ds-u-md-display--none ds-u-display--flex\">"},{"target":"<p class=\"share-text ds-u-font-size--lg\">"}]},"sia-r61":{"count":1,"ruleUrl":"https://alfa.siteimprove.com/rules/sia-r61","examples":[{"target":"{\"type\":\"document\",\"children\":[{\"type\":\"type\",\"name\":\"html\",\"publicId\":null,\"sys"}]},"sia-r57":{"count":1,"ruleUrl":"https://alfa.siteimprove.com/rules/sia-r57","examples":[{"target":"text: \"Feedback\""}]},"sia-r111":{"count":43,"ruleUrl":"https://alfa.siteimprove.com/rules/sia-r111","examples":[{"target":"<a href=\"/about-cms\" class=\"menu-item-link\" data-drupal-link-system-path=\"node/132926\" data-once=\"navigationLinkMatch\">"},{"target":"<a href=\"/about-cms/contact/newsroom\" class=\"menu-item-link\" data-drupal-link-system-path=\"node/43871\" data-once=\"navigationLinkMatch\">"},{"target":"<a href=\"/data-research\" class=\"menu-item-link\" data-drupal-link-system-path=\"node/132891\" data-once=\"navigationLinkMatch\">"}]}},"cantTellCount":72,"passedRules":38},"resources":{"engine":"resources","count":1,"byType":{"pdf":1},"resources":[{"url":"https://wcms.cms.gov:9009/Rhythmyx/psx_ceCMS_Dynamic_List_Item/HHS%20WOULD%20INCREASE%20REWARDS%20FOR%20REPORTING%20FRAUD%20TO%20NEARLY%20$10%20MILLION%20%20NEW%20FUNDS%20ALSO%20AVAILABLE%20TO%20EXPAND%20THE%20SENIOR%20MEDICARE%20PATROL%20PROGRAM%20%20Health%20and%20Human%20Services%20Secretary%20Kathleen%20Sebelius%20today%20announced%20a%20proposed%20rule%20that%20would%20increase%20rewards%20paid%20to%20Medicare%20beneficiaries%20and%20other%20individuals%20whose%20tips%20about%20suspected%20fraud%20lead%20to%20the%20successful%20recovery%20of%20funds%20to%20as%20high%20as%20$9.9%20million.%20A%20new%20funding%20opportunity,%20also%20released%20this%20month,%20supports%20the%20expansion%20of%20Senior%20Medicare%20Patrol%20activities%20to%20educate%20Medicare%20beneficiaries%20on%20how%20to%20prevent,%20detect%20and%20report%20Medicare%20fraud,%20waste%20and%20abuse.%20%20%E2%80%9CPresident%20Obama%20has%20made%20the%20elimination%20of%20fraud,%20waste%20and%20abuse,%20particularly%20in%20health%20care,%20a%20top%20priority%20for%20the%20administration,%E2%80%9D%20said%20Secretary%20Sebelius.%20%20%E2%80%9CToday%E2%80%99s%20announcement%20is%20a%20signal%20to%20Medicare%20beneficiaries%20and%20caregivers,%20who%20are%20on%20the%20frontlines%20of%20this%20fight,%20that%20they%20are%20critical%20partners%20in%20helping%20protect%20taxpayer%20dollars.%E2%80%9D%20%20%20Over%20the%20last%20three%20years%20we%20have%20recovered%20over%20$14.9%20billion%20in%20fraud.%20%20Some%20of%20this%20has%20resulted%20from%20fraud%20reporting%20by%20individuals%20%E2%80%93a%20proven%20tool%20for%20the%20government%20to%20detect%20fraud,%20waste%20and%20abuse%20in%20the%20Medicare%20program.%20%20Under%20the%20proposed%20changes,%20a%20person%20that%20provides%20specific%20information%20leading%20to%20the%20recovery%20of%20funds%20may%20be%20eligible%20to%20receive%20a%20reward%20of%2015%20percent%20of%20the%20amount%20recovered%20up%20to%20$10%20million.%20%20HHS%20currently%20offers%20a%20reward%20of%2010%20percent%20up%20to%20$1,000%20under%20the%20current%20incentive%20reward%20program.%20The%20changes%20are%20modeled%20on%20an%20IRS%20program%20that%20has%20returned%20$2%20billion%20in%20fraud%20since%202003.%20%20%20%20The%20proposed%20rule%20would%20also%20strengthen%20certain%20provider%20enrollment%20provisions%20including%20allowing%20HHS%20to%20deny%20enrollment%20of%20providers%20who%20are%20%20affiliated%20with%20an%20entity%20that%20has%20unpaid%20Medicare%20debt,%20deny%20or%20revoke%20billing%20privileges%20for%20individuals%20with%20felony%20convictions%20,%20and%20revoke%20providers%20and%20suppliers%20who%20are%20abusing%20their%20billing%20privileges.%20%20The%20Senior%20Medicare%20Patrol%20(SMP)%20is%20a%20national,%20volunteer-based%20program%20that%20empowers%20Medicare%20beneficiaries%20to%20prevent%20and%20report%20Medicare%20fraud,%20waste,%20and%20abuse.%20Since%201997,%20more%20than%203.5%20million%20beneficiaries%20have%20learned%20how%20to%20recognize%20and%20fight%20fraud%20and%20abuse,%20and%20more%20than%207,000%20referrals%20have%20been%20made%20to%20CMS%20and%20the%20Office%20of%20the%20Inspector%20General%20for%20investigation.%20To%20expand%20the%20SMP%20program%E2%80%99s%20capacity%20to%20reach%20more%20Medicare%20beneficiaries,%20the%20Administration%20for%20Community%20Living%20has%20issued%20a%20new%20Funding%20Opportunity.%20%20Each%20of%20the%20current%2054%20SMP%20projects%20is%20eligible%20for%20varying%20funding%20levels,%20up%20to%20a%20total%20of%20$7.3%20million%20across%20the%20program.%20%20These%20proposed%20changes%20will%20support%20the%20administration%E2%80%99s%20comprehensive%20approach%20to%20program%20integrity,%20including%20the%20work%20being%20done%20with%20the%20Health%20Care%20Fraud%20Prevention%20and%20Enforcement%20Action%20Team,%20a%20joint%20effort%20by%20HHS%20and%20the%20Department%20of%20Justice%20to%20fight%20health%20care%20fraud%20that%20recovered%20a%20record%20$4.2%20billion%20in%20taxpayer%20dollars%20in%20Fiscal%20Year%20(FY)%202012.%20%20To%20read%20a%20fact%20sheet%20about%20today%E2%80%99s%20proposed%20rule%20visit:%20%20To%20see%20the%20proposed%20rule%20visit:%20https:/www.federalregister.gov/public-inspection%20%20To%20learn%20more%20about%20Senior%20Medicare%20Patrols%20visit:%20http:/aoa.gov/AoA_Programs/Elder_Rights/SMP/%20%20To%20see%20the%20funding%20opportunity%20announcement%20visit:%20http:/www.acl.gov/Funding_Opportunities/Announcements/docs/2013/HHS-2013-ACL-AOA-SP-0049.pdf","type":"pdf"}]},"images":{"engine":"images","count":3,"images":[{"src":"https://www.cms.gov/themes/custom/cms_evo/logo.svg","alt":"CMS.gov","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":170,"renderedHeight":41,"naturalWidth":300,"naturalHeight":72,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":2086},{"src":"https://www.cms.gov/themes/custom/cms_evo/logo.svg","alt":"CMS.gov","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":167,"renderedHeight":40,"naturalWidth":300,"naturalHeight":72,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":2086},{"src":"https://www.cms.gov/themes/custom/cms_evo/images/hhslogo.png","alt":"HHS Logo","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":52,"renderedHeight":52,"naturalWidth":65,"naturalHeight":65,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":2762}]}}