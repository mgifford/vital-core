ling","label":"Service worker controls this page load","status":"fail","evidence":"","exampleUrl":"https://www.cms.gov/medicare-coverage-database/view/ncacal-decision-memo.aspx?bc=17&ncacaldoctype=all&ncaid=239&proposed=N&sortBy=status&status=all","why":"A controlling service worker means THIS page load is being served/intercepted, not just a future one."},{"id":"installable","label":"Meets basic installability criteria","status":"fail","evidence":"no readable web app manifest; no service worker registered","exampleUrl":"https://www.cms.gov/medicare-coverage-database/view/ncacal-decision-memo.aspx?bc=17&ncacaldoctype=all&ncaid=239&proposed=N&sortBy=status&status=all","why":"Determines whether the browser can realistically offer \"Add to Home Screen\" / install, based on manifest + service worker + HTTPS together."}],"manifest":null,"serviceWorker":{"registered":false,"active":false,"installing":false,"waiting":false,"controllingThisPage":false}}}}