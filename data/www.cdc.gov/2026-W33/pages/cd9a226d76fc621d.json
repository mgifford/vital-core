Decorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":481,"renderedHeight":502,"naturalWidth":481,"naturalHeight":502,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 509 characters — consider a caption or description","bytes":18175},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6332a3f2.gif","alt":"The figure above is a flow chart detailing recommendations regarding influenza vaccination of persons who report allergy to eggs in the United States for the 2014-15 influenza season. Persons with a history of egg allergy who have experienced only hives after exposure to egg should receive influenza vaccine. Because relatively few data are available for use of live attenuated influenza vaccine in this setting, inactivated influenza vaccines (IIV), or trivalent recombinant influenza vaccine (RIV3) should be used. RIV3 may be used for persons aged 18 through 49 years who have no other contraindications. However, IIV (egg- or cell-culture based) may also be used, with certain additional safety measures.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":481,"renderedHeight":836,"naturalWidth":481,"naturalHeight":836,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 709 characters — consider a caption or description","bytes":61350},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6058},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_word.gif","alt":"Microsoft Word file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidt