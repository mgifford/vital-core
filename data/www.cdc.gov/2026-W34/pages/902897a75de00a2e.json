 70% and the rate of OPR misuse- or abuse-related ED visits more than doubled. Cocaine deaths and ED visits declined during the same period. Starting in 2008, more women visited EDs because of misuse or abuse of benzodiazepines or OPRs than for cocaine.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":615,"renderedHeight":417,"naturalWidth":615,"naturalHeight":417,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 629 characters — consider a caption or description","bytes":22169},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6058},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_word.gif","alt":"Microsoft Word file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1087},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_excel.gif","alt":"Microsoft Excel file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":644},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_ppt.gif","alt":"Microsoft PowerPoint file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"alt