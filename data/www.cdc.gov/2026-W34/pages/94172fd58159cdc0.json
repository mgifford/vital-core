:false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":300,"renderedHeight":169,"naturalWidth":2500,"naturalHeight":1312,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":684072},{"src":"https://www.cdc.gov/diabetes/images/library/337438-a_foot_care_1200x630_facebook_3.24.jpg","alt":"Tips for Healthy Feet infographic","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":2500,"naturalHeight":1312,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":684072},{"src":"https://www.cdc.gov/diabetes/images/library/337438-a_foot_care_1200x675_twitter_3.24.jpg","alt":"Graphic Text Tips for Healthy Feet Most people with diabetes can prevent serious foot problems. Check your feet every day for cuts, redness, swelling, sores, blisters, corns, or calluses.  Wash your feet every day in warm (not hot) water and dry them well.  Never go barefoot, even inside.  Wear shoes that fit well and always wear socks.  Trim your toenails straight across and smooth out sharp edges with a nail file.  Don't try to remove corns or calluses yourself.  Get your feet checked at every health care visit and visit your foot doctor at least once a year.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":2500,"naturalHeight":1406,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 567 characters — consider a caption or description","bytes":755599},{"src":"https://www.cdc.gov/diabetes/images/library/337438-a_footcare_infographic_3.10_final.jpg","alt":"Tips for Healthy Feet (larger version)","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":2500,"naturalHeight":1406,"loadin