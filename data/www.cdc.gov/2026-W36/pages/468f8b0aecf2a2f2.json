":[{\"type\":\"type\",\"name\":\"html\",\"publicId\":\"-//W3C//"}]}},"cantTellCount":68,"passedRules":24},"plainLanguage":{"engine":"plain-language","scored":true,"scoreSkipReason":null,"wordCount":5686,"misspelledCount":99,"misspelled":["mmwrq","cdc","WeeklyJune","pdm","subtyped","subtype","antigenically","titers","antisera","oseltamivir","zanamivir","adamantanes","amantadine","rimantadine","serologic","ILINet","FluSurv","Rahul","Ganatra","Kniss","Epperson","Lenee","Blanton","Mustaquim","D'Mello"],"sentenceCount":203,"fleschReadingEase":43.3,"fleschKincaidGrade":14.2,"avgSentenceLength":28,"longSentences":109,"passiveVoiceRatio":0.222,"unexplainedAcronyms":["CDC","ILI","NET","MPH","MD","MS","RR","GA","US","FIGURE","URL","HTML","PDF","DC","DOC","PPT","MPEG","USA","INFO","TTY"],"unexplainedAcronymCount":20},"resources":{"engine":"resources","count":1,"byType":{"pdf":1},"resources":[{"url":"http://www.cdc.gov/mmwr/pdf/wk/mm6122.pdf","type":"pdf"}]},"images":{"engine":"images","count":18,"images":[{"src":"https://www.cdc.gov/TemplatePackage/images/cdcHeaderLogo.gif","alt":"CDC. Centers for Disease Control and Prevention. CDC 24/7: Saving Lives. Protecting People.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":470,"renderedHeight":47,"naturalWidth":470,"naturalHeight":47,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6834},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":14,"renderedHeight":14,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6058},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6122a4f1.gif","alt":"The figure shows the number and percentage of respiratory specimens testing positive for influenza reported to CDC, by type, surveillance week, and year, based on data from World Health Organization and National Respiratory and Enteric Virus Surveillance System collaborating laboratories, for the United States, during October 2, 2011-May 19, 2012. During this period, these collaborating laboratories tested 169,453 specimens for influenza viruses; 22,417 (13%) were positive. Of the positive specimens, 19,285 (86%) were influenza A viruses, and 3,132 (14%) were influenza B viruses. Among the influenza A viruses, 14,968 (78%) were subtyped; 11,002 (74%) were influenza A (H3N2) viruses, and 3,966 (26%) were pH1N1 viruses.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":614,"renderedHeight":373,"naturalWidth":614,"naturalHeight":373,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 727 characters — consider a caption or description","bytes":31576},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6122a4f2.gif","alt":"The figure shows the percentage of visits for influenza-like illness (ILI) reported to CDC, by surveillance week and year, based on data from the U.S. Outpatient Influenza-Like Illness Surveillance Network (ILINet), for the United States, during September 28, 2008-May 19, 2012. Nationally, the weekly percentage of outpatient visits for ILI met, but did not exceed, the national baseline level of 2.4% for 1 week (the week ending March 17, 2012) during the 2011-12 influenza season. This was the only season since ILINet began operating in its current configuration (i.e., since the 1997-98 season) that the percentage of outpatient visits for ILI did not exceed the baseline.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":614,"renderedHeight":340,"naturalWidth":614,"naturalHeight":340,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 677 characters — consider a caption or description","bytes":19733},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6122a4f3.gif","alt":"The figure shows rates of hospitalization for laboratory-confirmed influenza, by age group, surveillance week, and year, based on data from the FluSurv-NET surveillance system, for the United States, during October 2, 2011-April 28, 2012. The cumulative hospitalization rate (per 100,000 population) for this period was 14.2 among children aged 0-4 years, 4.2 among children aged 5-17 years, 4.1 among adults aged 18-49 years, 8.5 among adults aged 50-64 years, and 30.4 among adults aged ≥65 years. The cumulative incidence for all age groups since October 2, 2011, was 8.6 per 100,000.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":531,"renderedHeight":289,"naturalWidth":531,"naturalHeight":289,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 587 characters — consider a caption or description","bytes":12977},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6122a4f4.gif","alt":"The figure shows the percentage of all deaths attributable to pneumonia and influenza, by surveillance week and year, based on data from the 122 Cities Mortality Reporting System, for the United States, during the year 2007 through May 19, 2012. During the 2011-12 influenza season, the percentage of deaths attributed to pneumonia and influenza exceeded the epidemic threshold for 1 week, during the week ending January 21, 2012 (week 3) and peaked at 7.9%.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":620,"renderedHeight":331,"naturalWidth":620,"naturalHeight":331,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 458 characters — consider a caption or description","bytes":29272},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","ha