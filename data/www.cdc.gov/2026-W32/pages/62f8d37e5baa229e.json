150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"DECORATIVE","altReason":"aria-hidden=\"true\"","bytes":377},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/uswds/icon-https.svg","alt":"","hasAlt":true,"isDecorative":true,"isMissingAlt":false,"ariaHidden":true,"rolePresentation":false,"renderedWidth":150,"renderedHeight":150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"DECORATIVE","altReason":"aria-hidden=\"true\"","bytes":325},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/logo-notext.svg","alt":"Centers for Disease Control and Prevention. CDC twenty four seven. Saving Lives, Protecting People","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":125,"renderedHeight":81,"naturalWidth":233,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1262},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/logo-notext.svg","alt":"Centers for Disease Control and Prevention. CDC twenty four seven. Saving Lives, Protecting People","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":233,"renderedHeight":150,"naturalWidth":233,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1262},{"src":"https://www.cdc.gov/phap/media/images/2024/09/William-Carson-Testimonial.jpg","alt":"I am a member of Ohkay Owingeh (formerly San Juan Pueblo). I attempted to work on Native American health issues during my MPH program, but I knew I needed real-world experience in Native communities beyond academics. During PHAP, I worked on national-scale public health issues in Tribal Nations such as Navajo Nation, White Mountain Apache, and Muscogee Creek Nation. Without my two years in PHAP, I don’t think I would be pursuing the goals I have today.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":329,"naturalWidth":800,"naturalHeight":800,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 456 characters — consider a caption or description","bytes":271995},{"src":"https://www.cdc.gov/phap/media/images/2024/09/Kiana-Davis-Testimonial.jpg","alt":"During my PHAP tenure, I helped enhance my health department's services to the rural community alongside local, state, and tribal partners. This included implementing policies and procedures to fulfill federal environmental health program standards, conducting a Community Health Assessment (CHA), and developing a Community Health Improvement Plan (CHIP).  These experiences refined my skills and prepared me for other public health initiatives.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":329,"naturalWidth":800,"naturalHeight":800,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 446 characters — consider a caption or description","bytes":258067},{"src":"https://www.cdc.gov/phap/media/images/2024/10/Aram-Del-Junco-Testimonial-100324.jpg","alt":"Through PHAP, I have gained unique experiences that I know I would not have gotten elsewhere. From working with high school students to reduce vaping, to working with the Spanish-speaking on achieving better health goals, PHAP has taught me lifelong public health lessons","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":329,"naturalWidth":800,"naturalHeight":800,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 271 characters — consider a caption or description","bytes":476106},{"src":"https://www.cdc.gov/phap/media/images/2024/10/Dorothy-Nelson-Testimonial.jpg","alt":"PHAP is a unique opportunity for recent undergraduates to experience what public health really looks like outside of a textbook. I was not a typical associate, having joined after earning a master's degree and working at my local health department, but PHAP has still been invaluable for the insight I've gained.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":329,"naturalWidth":800,"naturalHeight":800,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 312 characters — consider a caption or description","bytes":252220},{"src":"https://www.cdc.gov/phap/media/captions-images/300666_PHAPStoriesJamila_Shields.jpg","alt":"Jamila Shields","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":185,"naturalWidth":1920,"naturalHeight":1080,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":502841},{"src":"https://www.cdc.gov/phap/media/captions-images/Wojciechowska.jpg","alt":"Klaudia Wojciechowska","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":185,"naturalWidth":1920,"naturalHeight":1080,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":730794},{"src":"https://www.cdc.gov/phap/media/captions-images/harris.jpg","alt":"Adrick Harris","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHeight":185,"naturalWidth":1920,"naturalHeight":1080,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":624530},{"src":"https://www.cdc.gov/phap/media/captions-images/trapp.jpg","alt":"Haley Trapp","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":329,"renderedHei