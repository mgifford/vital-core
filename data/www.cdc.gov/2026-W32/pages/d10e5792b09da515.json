MissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":1200,"naturalHeight":675,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":325697},{"src":"https://www.cdc.gov/child-passenger-safety/media/images/CDC_BSG_Graphic_Updates_H9.png","alt":"Example of a young girl with good seat belt fit with a booster seat. The shoulder belt is across the center of her shoulder and chest, the lap belt is across her upper thighs, and the seat belt goes under the booster’s armrests.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":1200,"naturalHeight":675,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":237328},{"src":"https://www.cdc.gov/child-passenger-safety/media/images/CDC_BSG_Graphic_Updates_H10.png","alt":"Two examples of a young girl sitting in the car, one correct with her in the booster seat with the shoulder belt across the middle of her chest and shoulder and the lap belt across her upper thighs, the other incorrect with no booster seat and the shoulder belt is off of her shoulder, and the lap belt is across her stomach.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":1200,"naturalHeight":675,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 325 characters — consider a caption or description","bytes":314365},{"src":"https://www.cdc.gov/child-passenger-safety/media/images/CDC_BSG_Graphic_Updates_H11.png","alt":"Two examples of a young girl sitting in the car, one correct with her in a high-back booster seat with the shoulder belt across the middle of her chest and shoulder and the lap belt across her upper thighs, the other incorrect with no booster seat and the shoulder belt is 