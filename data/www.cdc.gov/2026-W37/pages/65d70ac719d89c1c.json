ct":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/su6102a4f.gif","alt":"This figure shows a line graph with four lines indicating estimated prevalence of 1) hypertension, 2) hypertension treatment, 3) blood pressure control among persons being treated for hypertension, and 4) blood pressure control among all persons with hypertension. Data points are shown for the 1999-2000, 2001-2002, 2003-2004, 2005-2006, and 2007-2008 survey years for adults aged ≥18 years. The data indicate that the prevalence of hypertension in U.S. adults did not change substantially from 1999-2000 (28.7%) to 2007-2008 (29.5%). However, the prevalence of treatment, control among all persons with hypertension, and control among persons taking blood pressure-lowering medication increased during the 10-year period 1999-2008. Data are from the National Health and Nutrition Examination Survey.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":515,"renderedHeight":345,"naturalWidth":515,"naturalHeight":345,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 801 characters — consider a caption or description","bytes":13507},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_out.png","alt":"External Web Site Icon","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":10,"renderedHeight":10,"naturalWidth":10,"naturalHeight":10,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes"