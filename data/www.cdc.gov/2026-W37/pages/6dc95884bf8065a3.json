altReason":"present, no red flags","bytes":9315},{"src":"https://www.cdc.gov/mmwr/volumes/69/wr/figures/mm6945a10-F.gif?_=32249","alt":"The figure is a line chart showing death rates from unintentional falls among persons aged ≥65 years, by age group, in the United States during 1999–2018, according to the National Vital Statistics System. From 1999 to 2018, death rates from unintentional falls among persons aged ≥65 years increased among all age groups. The largest increase occurred among persons aged ≥85 years, from 110.2 per 100,000 in 1999 to 270.5 in 2018. For persons aged 75–84 years, the rate increased from 31.5 to 63.1, and among those aged 65–74 years, the rate increased from 9.0 to 16.8. Throughout the period, rates were highest among persons aged ≥85 years, followed by rates among persons aged 75–84 years, and were lowest among persons aged 65–74 years.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":671,"renderedHeight":439,"naturalWidth":671,"naturalHeight":439,"loading":null,"decoding":"async","altVerdict":"TOO_LONG","altReason":"alt text is 740 characters — consider a caption or description","bytes":14411},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/cdc-logo-tag-right.svg","alt":"Centers for Disease Control and Prevention","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":283,"renderedHeight":66,"naturalWidth":827,"naturalHeight":193,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":4780},{"src":"https://www.cdc.gov/TemplatePackage/contrib/libs/cdc/c2r/crlogo.svg","alt":"Content Credentials logo","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":25,"renderedHeight":150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","byt