:true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":398,"renderedHeight":36,"naturalWidth":398,"naturalHeight":36,"loading":null,"decoding":"async","altVerdict":"GOOD","altReason":"present, no red flags","bytes":3560},{"src":"https://cdn.altmetric.com/v1/9.png","alt":"Article has an altmetric score of 9","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":110,"renderedHeight":20,"naturalWidth":110,"naturalHeight":20,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":2497},{"src":"https://www.cdc.gov/pcd/issues/2018/images/17_0344_01.gif?_=80791","alt":"The clinical phase of the EIM Solution. Steps 1 through 3 of the EIM Solution take place primarily in the clinic setting and involve patients having their physical activity levels assessed, receiving brief counseling from a member of the health care team and/or receiving a semi-customized physical activity prescription, and receiving a referral to EIM network of physical activity resources. In some health systems, patients may also interact with, or be referred to, an intervention advisor. The role of the intervention advisor could include behavior change counseling and connecting the patient to the EIM network of physical activity resources. Dashed lines indicate an indirect or alternative pathway. The gray box indicates the community phase of the EIM Solution. Abbreviation: EIM, Exercise is Medicine.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":1110,"renderedHeight":162,"naturalWidth":null,"naturalHeight":null,"loading":null,"decoding":"async","altVerdict":"TOO_LONG","altReason":"alt text is 813 characters — consider a caption or description","bytes":20905},{"src":"https://www.cdc.gov/pcd/issues/2018/images/17_0344_02.gif?_=80792","alt":"The “community” phase of the EIM Solution. The fourth step of the EIM Solution involves the linkage of patients from health care systems to a supportive network of physical activity programs, places, and professionals. These EIM networks may be developed by using existing programs and professionals internally within a health system or externally in the community setting or connecting patients to resources for self-directed management. The dashed lines indicate alternative pathways. Abbreviation: EIM, Exercise is Medicine.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":1110,"renderedHeight":108,"naturalWidth":null,"naturalHeight":null,"loading":null,"decoding":"async","altVerdict":"TOO_LONG","altReason":"alt text is 527 characters — consider a caption or description","bytes":20905},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/cdc-logo-tag-right.svg","alt":"Centers for Disease Control and Prevention","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":283,"renderedHeight":66,"naturalWidth":827,"naturalHeight":193,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":4780},{"src":"https://www.cdc.gov/TemplatePackage/contrib/libs/cdc/c2r/crlogo.svg","alt":"Content Credentials logo","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":25,"renderedHeight":150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1490}]}}