a for women screened more than 3 years ago but less than 5 years ago are not shown. Abbreviation: BRFSS, Behavioral Risk Factor Surveillance System; HPV, human papilloma virus.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":920,"renderedHeight":501,"naturalWidth":920,"naturalHeight":501,"loading":null,"decoding":"async","altVerdict":"TOO_LONG","altReason":"alt text is 1313 characters — consider a caption or description","bytes":9768},{"src":"https://www.cdc.gov/images/arrow_up.gif","alt":"Return to your place in the text","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":58,"renderedHeight":34,"naturalWidth":58,"naturalHeight":34,"loading":null,"decoding":"async","altVerdict":"GOOD","altReason":"present, no red flags","bytes":1221},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/cdc-logo-tag-right.svg","alt":"Centers for Disease Control and Prevention","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":283,"renderedHeight":66,"naturalWidth":827,"naturalHeight":193,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":4780},{"src":"https://www.cdc.gov/TemplatePackage/contrib/libs/cdc/c2r/crlogo.svg","alt":"Content Credentials logo","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":25,"renderedHeight":150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1490}]}}