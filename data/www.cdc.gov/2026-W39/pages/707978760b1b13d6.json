esentation":false,"renderedWidth":10,"renderedHeight":10,"naturalWidth":10,"naturalHeight":10,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_out.png","alt":"External Web Site Icon","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":10,"renderedHeight":10,"naturalWidth":10,"naturalHeight":10,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_out.png","alt":"External Web Site Icon","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":10,"renderedHeight":10,"naturalWidth":10,"naturalHeight":10,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_out.png","alt":"External Web Site Icon","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":10,"renderedHeight":10,"naturalWidth":10,"naturalHeight":10,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":232},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6314a4f1.gif","alt":"The figure shows birth rates for teens aged 15-17 years, by age, in the United States during 1991-2012. The rate of births per 1,000 teens aged 15-17 years declined 63%, from 38.6 in 1991 to 14.1 in 2012. From 1991 to 2012, the rate of births per 1,000 teens declined from 17.9 to 5.4 for those aged 15 years, 36.9 to 12.9 for those aged 16 years, and 60.6 to 23.7 for those aged 17 years.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":614,"renderedHeight":472,"naturalWidth":614,"naturalHeight":472,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 389 characters — consider a caption or description","bytes":16789},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6314a4f2.gif","alt":"The figure shows birth rates for teens aged 15-17 years, by reporting area, in the United States during 2012. In 2012, the birth rate per 1,000 teens aged 15-17 years varied by race/ethnicity, with the highest rates among Hispanics (25.5), followed by non-Hispanic blacks (21.9), American Indians/Alaska Natives (17.0), non-Hispanic whites (8.4), and Asians/Pacific Islanders (4.1). The rate of births to teens aged 15-17 years also varied widely by state, with the highest rate in the District of Columbia (29.0 per 1,000 teens aged 15-17 years) and the lowest rate in New Hampshire (6.2).","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":598,"renderedHeight":446,"naturalWidth":598,"naturalHeight":446,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 590 characters — consider a caption or description","bytes":29023},{"src":"https://www.cdc.gov/mmwr/preview/mmwrhtml/figures/m6314a4f3.gif","alt":"The figure shows the number of teen births that were to teens aged 15-17 years compared with teens aged 18-19 years in the United States during 1991-2012. In 2012, among 305,388 births to teens aged 15-19 years, 86,423 (28.3%) were births to teens aged 15-17 years. The percentage of births to teens aged 15-19 years that were to teens aged 15-17 years declined significantly during the observation period, from 36% in 1991 to 28% in 2012, representing a 22% decrease.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":619,"renderedHeight":440,"naturalWidth":619,"naturalHeight":440,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 468 characters — consider a caption or description","bytes":29512},{"src":"https://